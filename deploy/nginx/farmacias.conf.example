# OPCIONAL: si el servidor ya tiene Nginx/Certbot en el host, publique el contenedor
# web de producción en 127.0.0.1:8088 cambiando PROD_WEB_PORT y use este proxy.
server {
    listen 80;
    server_name farmacias.example.com;
    location / {
        proxy_pass http://127.0.0.1:8088;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
